<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline compile harness: builds every Editor/ source file against the real
    s&box assemblies so API usage is verified without launching the editor.
    Not used by s&box itself - the editor compiles Editor/ directly.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SboxMcp.Dev</AssemblyName>
    <RootNamespace>SboxMcp</RootNamespace>
    <SboxManaged Condition="'$(SboxManaged)' == ''">D:\SteamLibrary\steamapps\common\sbox\bin\managed</SboxManaged>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Editor\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(SboxManaged)\Sandbox.*.dll" Private="false" />
  </ItemGroup>

</Project>
